graph TB
    %% Elementos del diagrama
    D[dataset_distribuido.csv\n(50,000 registros)]
    class D source
    C[Coordinador Principal]
    class C coordinator
    D --> C
    C1[Bloque 1\nWorker 1]
    C2[Bloque 2\nWorker 2]
    C3[Bloque 3\nWorker 3]
    C4[Bloque 4\nWorker 4]
    class C1 C2 C3 C4 processor
    C --> C1
    C --> C2
    C --> C3
    C --> C4
    W1[Worker 1\nProcesamiento]
    W2[Worker 2\nProcesamiento]
    W3[Worker 3\nProcesamiento]
    W4[Worker 4\nProcesamiento]
    class W1 W2 W3 W4 processor
    W1 -.->|Part. A| W2
    W2 -.->|Part. B| W3
    W3 -.->|Part. C| W4
    R[Consolador Central]
    class R reducer
    W1 --> R
    W2 --> R
    W3 --> R
    W4 --> R
    G1[CSV Consolidado]
    G2[JSON Consolidado]
    G3[Gráficos Categoría]
    G4[Gráficos Región]
    G5[Comparativa Tiempos]
    R --> G1
    R --> G2
    G1 --> G3
    G2 --> G4
    G3 --> G5
    G4 --> G5
    M1[Tiempo Lectura (ms)]
    M2[Speedup Observado]
    G5 --> M1
    G5 --> M2